def question_agent(question):

    role = """
You are a helpful general AI assistant.

Answer the user's question clearly and concisely.
"""

    return ask_ai(
        role,
        question
    )


# ============================================================
# ORCHESTRATOR AGENT
# ============================================================

def orchestrator_agent(user_task):

    role = """
You are an Orchestrator Agent.

Classify the user's request into exactly ONE category:

DEBATE
CONTENT
MEMORY
HISTORY
QUESTION

Rules:

DEBATE:
- pros and cons
- debate
- argue for and against
- should / should not
- balanced judgment

CONTENT:
- article
- report
- research and write
- write-up
- structured content

MEMORY:
- asks about saved facts
- asks what the system remembers
- asks what has been stored in memory

HISTORY:
- asks what happened before
- asks what was discussed earlier
- asks about previous tasks
- asks about previous answers

QUESTION:
- normal questions
- explanations
- definitions
- general information

Return ONLY ONE WORD:
DEBATE
CONTENT
MEMORY
HISTORY
or
QUESTION
"""

    result = ask_ai(
        role,
        user_task
    )

    result = result.strip().upper()

    # Remove possible extra spaces/newlines
    result = result.split()[0] if result else ""

    valid_categories = {
        "DEBATE",
        "CONTENT",
        "MEMORY",
        "HISTORY",
        "QUESTION"
    }

    if result in valid_categories:
        return result

    return "QUESTION"


