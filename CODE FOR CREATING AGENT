# SMART WORKFLOW
# ============================================================

def smart_workflow(user_task):

    print("\n" + "=" * 60)
    print("CATEGORY 4 - ORCHESTRATION AND WORKFLOWS")
    print("=" * 60)

    route = orchestrator_agent(
        user_task
    )

    print(
        f"\nOrchestrator selected: {route}"
    )

    # --------------------------------------------------------
    # DEBATE
    # --------------------------------------------------------

    if route == "DEBATE":

        answer = debate_workflow(
            user_task
        )

    # --------------------------------------------------------
    # CONTENT
    # --------------------------------------------------------

    elif route == "CONTENT":

        answer = content_workflow(
            user_task
        )

    # --------------------------------------------------------
    # MEMORY
    # --------------------------------------------------------

    elif route == "MEMORY":

        answer = memory_agent(
            user_task
        )

    # --------------------------------------------------------
    # HISTORY
    # --------------------------------------------------------

    elif route == "HISTORY":

        answer = history_agent(
            user_task
        )

    # --------------------------------------------------------
    # GENERAL QUESTION
    # --------------------------------------------------------

    else:

        answer = question_agent(
            user_task
        )

    # Save interaction
    add_to_session_history(
        user_task,
        answer
    )

    save_persistent_history(
        user_task,
        answer
    )

    return answer


