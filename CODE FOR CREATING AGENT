import json
from pathlib import Path


# ============================================================
# FILE CONFIGURATION
# ============================================================

HISTORY_FILE = Path("history.json")
MEMORY_FILE = Path("memory.json")


# ============================================================
# SESSION HISTORY
# ============================================================

history = []


def add_to_session_history(task, answer):
    """
    Add a task and answer to the current session.
    """

    history.append({
        "task": task,
        "answer": answer
    })


def show_session_history():
    """
    Display history from the current Python session.
    """

    if not history:
        print("\nNo session history yet.")
        return

    print("\n" + "=" * 60)
    print("SESSION HISTORY")
    print("=" * 60)

    for number, item in enumerate(history, start=1):

        print(f"\n{number}. Task:")
        print(item["task"])

        print("\nAnswer:")
        print(item["answer"])


# ============================================================
# PERSISTENT HISTORY
# ============================================================

def load_persistent_history():
    """
    Load history from history.json.
    """

    if not HISTORY_FILE.exists():
        return []

    try:

        data = HISTORY_FILE.read_text(
            encoding="utf-8"
        )

        return json.loads(data)

    except (json.JSONDecodeError, OSError) as error:

        print(f"\nCould not load history: {error}")

        return []


def save_persistent_history(task, answer):
    """
    Save a task and answer permanently
    inside history.json.
    """

    saved = load_persistent_history()

    saved.append({
        "task": task,
        "answer": answer
    })

    try:

        HISTORY_FILE.write_text(
            json.dumps(
                saved,
                indent=2,
                ensure_ascii=False
            ),
            encoding="utf-8"
        )

    except OSError as error:

        print(f"\nCould not save history: {error}")


def show_persistent_history():
    """
    Display history saved in history.json.
    """

    saved = load_persistent_history()

    if not saved:
        print("\nNo persistent history yet.")
        return

    print("\n" + "=" * 60)
    print("PERSISTENT HISTORY")
    print("=" * 60)

    for number, item in enumerate(saved, start=1):

        print(f"\n{number}. Task:")
        print(item["task"])

        print("\nAnswer:")
        print(item["answer"])


# ============================================================
# MEMORY
# ============================================================

def load_memory():
    """
    Load saved memories from memory.json.
    """

    if not MEMORY_FILE.exists():
        return []

    try:

        data = MEMORY_FILE.read_text(
            encoding="utf-8"
        )

        return json.loads(data)

    except (json.JSONDecodeError, OSError) as error:

        print(f"\nCould not load memory: {error}")

        return []


def save_memory(information):
    """
    Save new information permanently
    inside memory.json.
    """

    memories = load_memory()

    memories.append(information)

    try:

        MEMORY_FILE.write_text(
            json.dumps(
                memories,
                indent=2,
                ensure_ascii=False
            ),
            encoding="utf-8"
        )

    except OSError as error:

        print(f"\nCould not save memory: {error}")


# ============================================================
# MEMORY AGENT
# ============================================================

def memory_agent(question):
    """
    Ask the AI a question using only saved memory.
    """

    memories = load_memory()

    if not memories:
        return "No memory has been saved yet."

    memory_text = "\n".join(
        f"- {item}"
        for item in memories
    )

    role = """
You are a Memory Agent.

Answer the user's question using ONLY
the stored memory.

Do not use outside information.

If the answer is unavailable,
say exactly:

Not found in memory.
"""

    prompt = f"""
STORED MEMORY:

{memory_text}

QUESTION:

{question}
"""

    return ask_ai(
        role,
        prompt
    )


# ============================================================
# HISTORY AGENT
# ============================================================

def history_agent(question):
    """
    Ask the AI a question using only
    the saved conversation history.
    """

    saved = load_persistent_history()

    if not saved:
        return "No conversation history is available."

    history_text = json.dumps(
        saved,
        indent=2,
        ensure_ascii=False
    )

    role = """
You are a History Agent.

Use ONLY the supplied interaction history.

Answer questions about:

- Earlier tasks
- Earlier answers
- Previous decisions
- Previous interactions

Do not use outside information.

If the answer cannot be found,
say exactly:

Not found in history.
"""

    prompt = f"""
HISTORY:

{history_text}

QUESTION:

{question}
"""

    return ask_ai(
        role,
        prompt
    )


