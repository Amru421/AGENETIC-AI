from ask_ai import ask_ai

# Get topic from user
topic = input("Enter the topic: ")


def pro_agent(topic):
    role = """
You are the Pro Agent.
Support the topic.
Give arguments, benefits, and examples.
"""
    return ask_ai(role, topic)


def con_agent(topic):
    role = """
You are the Con Agent.
Oppose the topic.
Give risks, disadvantages, and examples.
"""
    return ask_ai(role, topic)


def judge_agent(topic, pro_answer, con_answer):
    role = """
You are the Judge Agent.
Compare both sides and give a final conclusion.
"""

    question = f"""
TOPIC:
{topic}

PRO AGENT:
{pro_answer}

CON AGENT:
{con_answer}
"""

    return ask_ai(role, question)


def workflow(topic):
    pro_answer = pro_agent(topic)
    con_answer = con_agent(topic)

    judge_answer = judge_agent(
        topic,
        pro_answer,
        con_answer
    )

    print("\n===== PRO AGENT =====")
    print(pro_answer)

    print("\n===== CON AGENT =====")
    print(con_answer)

    print("\n===== JUDGE AGENT =====")
    print(judge_answer)


workflow(topic)

