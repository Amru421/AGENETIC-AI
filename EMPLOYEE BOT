MEMORY_FILE = Path("homework.json")


# ============================================================
# AI API FUNCTION
# ============================================================

def ask_ai(role, question):

    data = {
        "model": MODEL,
        "messages": [
            {
                "role": "system",
                "content": role
            },
            {
                "role": "user",
                "content": question
            }
        ]
    }

    headers = {
        "Authorization": f"Bearer {API_KEY}",
        "Content-Type": "application/json"
    }

    request = urllib.request.Request(
        API_URL,
        data=json.dumps(data).encode("utf-8"),
        headers=headers,
        method="POST"
    )

    try:

        with urllib.request.urlopen(
            request,
            timeout=60
        ) as response:

            response_data = response.read().decode("utf-8")

            result = json.loads(response_data)

        if "choices" not in result:
            return f"API Error: {result}"

        return result["choices"][0]["message"]["content"]

    except urllib.error.HTTPError as e:

        error_message = e.read().decode("utf-8")

        return (
            f"\nHTTP ERROR {e.code}\n"
            f"{error_message}\n"
        )

    except urllib.error.URLError as e:

        return (
            "\nCONNECTION ERROR\n"
            f"{e.reason}\n"
        )

    except Exception as e:

        return (
            "\nUNEXPECTED ERROR\n"
            f"{str(e)}\n"
        )


# ============================================================
# LOAD EMPLOYEE MEMORY
# ============================================================

def load_memory():
    """
    Load employee information from employee_memory.json.
    """

    if not MEMORY_FILE.exists():
        return []

    try:

        data = MEMORY_FILE.read_text(
            encoding="utf-8"
        )

        return json.loads(data)

    except (json.JSONDecodeError, OSError) as error:

        print(
            f"\nCould not load employee memory: {error}"
        )

        return []


# ============================================================
# SAVE EMPLOYEE MEMORY
# ============================================================

def save_memory(employee_information):
    """
    Save fictional employee/project information
    permanently inside employee_memory.json.
    """

    memories = load_memory()

    memories.append(employee_information)

    try:

        MEMORY_FILE.write_text(
            json.dumps(
                memories,
                indent=4,
                ensure_ascii=False
            ),
            encoding="utf-8"
        )

        print("\nEmployee information saved successfully.")

    except OSError as error:

        print(
            f"\nCould not save employee memory: {error}"
        )


# ============================================================
# DISPLAY SAVED MEMORY
# ============================================================

def show_memory():

    memories = load_memory()

    if not memories:

        print("\nNo employee information found.")

        return

    print("\n")
    print("=" * 60)
    print("SAVED EMPLOYEE MEMORY")
    print("=" * 60)

    for number, employee in enumerate(
        memories,
        start=1
    ):

        print(f"\nEmployee {number}")
        print("-" * 40)

        for key, value in employee.items():

            print(
                f"{key}: {value}"
            )


# ============================================================
# MEMORY AGENT
# ============================================================

def memory_agent(question):
    """
    Answer employee-related questions using ONLY
    information stored in employee memory.
    """

    memories = load_memory()

    if not memories:

        return "No employee information has been saved yet."

    memory_text = json.dumps(
        memories,
        indent=4,
        ensure_ascii=False
    )

    role = """
You are an Employee Information Memory Agent.

Your job is to answer questions ONLY using
the employee and project information provided
in STORED EMPLOYEE MEMORY.

Rules:

1. Do not use outside information.
2. Do not invent employee details.
3. Do not guess missing information.
4. If the requested information is not available,
   respond exactly:

Not found in employee memory.

5. Give short and clear answers.
6. You may compare employees if the required
   information exists in memory.
"""

    prompt = f"""
STORED EMPLOYEE MEMORY:

{memory_text}


USER QUESTION:

{question}
"""

    return ask_ai(
        role,
        prompt
    )


